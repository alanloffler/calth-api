{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@admin/*": ["./src/admin/*"],
      "@auth/*": ["./src/auth/*"],
      "@business/*": ["./src/business/*"],
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@events/*": ["./src/events/*"],
      "@medical-history/*": ["./src/medical-history/*"],
      "@notifications/*": ["src/notifications/*"],
      "@permissions/*": ["./src/permissions/*"],
      "@patient-profile/*": ["./src/patient-profile/*"],
      "@professional-profile/*": ["./src/professional-profile/*"],
      "@roles/*": ["./src/roles/*"],
      "@settings/*": ["./src/settings/*"],
      "@users/*": ["./src/users/*"],
      "@/*": ["./src/*"]
    }
  }
}
